# Parlour backup script credentials — EXAMPLE FILE.
#
# The real file is NOT in this repo. It lives at the absolute path the script
# sources, default /home/marty/parlour-backups/backup.env (override with
# PARLOUR_BACKUP_ENV_FILE). Copy this file there, fill in the real values,
# and chmod 600. The committed example must never hold a real credential.
#
# ops/backup.env is git-ignored so a real env file can never be committed
# from inside the repo.
NEO4J_PASSWORD=CHANGE_ME
