# =============================================================================
# The Author Library — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments. All values shown are defaults.

# --- Database ---
DB_POSTGRES_URL=postgresql://author_library:author_library@localhost:5432/author_library
DB_NEO4J_URL=bolt://localhost:7687
DB_NEO4J_USER=neo4j
DB_NEO4J_PASSWORD=neo4j_dev

# --- API Keys ---
# Required: Anthropic API key for LLM-powered features
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Voyage AI for embeddings (default provider)
VOYAGE_API_KEY=

# Optional: OpenAI embeddings (alternative provider)
OPENAI_API_KEY=

# --- Embedding Configuration ---
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3-large
EMBEDDING_DIMENSIONS=1024

# --- LLM Configuration ---
LLM_INGESTION_MODEL=claude-sonnet-4-5-20250929
LLM_QUERY_MODEL=claude-sonnet-4-5-20250929

# --- Server ---
SERVER_TRANSPORT=stdio
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_LOG_LEVEL=INFO
# Log format: "console" for development, "json" for production
SERVER_LOG_FORMAT=console
